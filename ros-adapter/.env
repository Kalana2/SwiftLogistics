PORT=3003
NODE_ENV=development

# RabbitMQ
RABBITMQ_URL=amqp://localhost:5672

# Route Optimization Service (Mock or real API)
ROS_API_URL=https://api.mapbox.com/directions/v5
ROS_API_KEY=your_mapbox_api_key_here

# Alternative: Google Maps API
# ROS_API_URL=https://maps.googleapis.com/maps/api/directions/json
# ROS_API_KEY=your_google_maps_api_key

# Orchestrator
ORCHESTRATOR_URL=http://localhost:3001

# Logging
LOG_LEVEL=info
